

profiles {
    
    gemini {

        process {
            withLabel: process_local {
                executor = 'local'
            }

            withLabel: mmseqs_heavy {
                executor = 'slurm'
                queue = 'compute'
                cpus = '8'
                memory = '64GB'
                clusterOptions = '--time=1:00:00'
                conda = "$HOME/miniconda3/envs/mmseqs2"
            }

            withLabel: episcaf_local {
                executor = "local"
                conda = "$HOME/miniconda3/envs/episcaf-experiments"
            }

        }
    }
}
