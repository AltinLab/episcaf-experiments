

profiles {
    
    gemini {
        params {
            // just the cloned repo + setup instructions executed
            dl_binder_design_path = "/tgen_labs/altin/alphafold3/workspace/dl_binder_design"
            rfdiffusion_models_path = "/packages/RFdiffusion/1.1.0/models"
            rfdiffusion_schedule_path = "/tgen_labs/altin/alphafold3/rfdiffusion_cache"
        }

        process {
            withLabel: proteinmpnn_local {
                executor = 'local'
                conda = "$HOME/miniconda3/envs/proteinmpnn_binder_design"
            }

            withLabel: proteinmpnn_gpu {
                executor = 'slurm'
                queue = 'gpu-v100'
                cpus = '8'
                memory = '64GB'
                clusterOptions = '--nodes=1 --ntasks=1 --gres=gpu:1 --time=1:00:00'
                conda = "$HOME/miniconda3/envs/proteinmpnn_binder_design"
            }

            withLabel: rfdiffusion {
                executor = 'slurm'
                queue = 'gpu-v100'
                cpus = '8'
                memory = '64GB'
                clusterOptions = '--nodes=1 --ntasks=1 --gres=gpu:1 --time=2:00:00'
                container = '/packages/containers/RFdiffusion/1.1.0.sif'
                containerOptions = '--nv -B /scratch,/tgen_labs,/packages --cleanenv'
                beforeScript = 'module load singularity && export SINGULARITYENV_TMPDIR=/scratch/$USER/tmp'
            }

        }
    }
}
